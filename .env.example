# ==============================================================================
# PROJECT ATLAS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure local values before running.
# NEVER commit .env to version control.
# ==============================================================================

# Application & API Settings
ENVIRONMENT=development
PORT=8000
DEBUG=true
LOG_LEVEL=INFO
ADMIN_API_KEY=atlas-admin-secret-key-change-in-production

# Gemini LLM Settings
# Provide your Google Gemini API key below:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Qdrant Vector Store Settings
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=report_chunks
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# MySQL Primary Operational Database (App User)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=project_atlas
MYSQL_USER=atlas_app
MYSQL_PASSWORD=atlas_app_secure_password
MYSQL_ROOT_PASSWORD=atlas_root_secure_password

# MySQL Read-Only Database (Analytical User for Safe SQL Tool)
MYSQL_READONLY_USER=atlas_readonly
MYSQL_READONLY_PASSWORD=atlas_readonly_secure_password

# CodeIgniter 3 Portal Settings
PORTAL_PORT=8080
CI_ENV=development
API_BASE_URL=http://api:8000
